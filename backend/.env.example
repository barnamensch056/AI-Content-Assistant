# Backend Configuration
DATABASE_URL=sqlite:///./content_assistant.db

# LLM Provider: "openai" or "ollama"
LLM_PROVIDER=openai

# OpenAI / Groq Settings (if using LLM_PROVIDER=openai)
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=llama-3.1-8b-instant
# If using Groq (free), set this base URL:
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# If using standard OpenAI, comment out or leave OPENAI_BASE_URL blank:
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini

# Ollama Settings (if using LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Timeouts & Retries
LLM_TIMEOUT_SECONDS=30.0

# CORS (Frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
